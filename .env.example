# Server
PORT=5000
NODE_ENV=development

# MongoDB
# Local:            mongodb://127.0.0.1:27017/mediscan
# MongoDB Atlas:     mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mediscan
MONGO_URI=mongodb://127.0.0.1:27017/mediscan

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# --- Multimodal wound assessment model integration ---
# The trained model (EfficientNet-B0 image encoder + DistilBERT text encoder,
# fused into 3 heads: wound class / severity / urgency) is served by the
# FastAPI app in ./model-service (see model-service/README.md). Point this at
# it once it's running:
#   MODEL_API_URL=http://localhost:8000/predict
# It accepts POST { description, imageBase64 } and returns
#   { wound_class, wound_confidence, severity, severity_confidence, urgency, urgency_confidence }
# Leave blank to use the built-in local fallback for frontend/UI testing only
# (NOT the trained model).
MODEL_API_URL=
MODEL_API_KEY=
MODEL_API_TIMEOUT_MS=15000

# CORS - comma separated list of allowed origins (frontend URLs)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:5500

# Emergency call number shown in the UI
EMERGENCY_NUMBER=108
